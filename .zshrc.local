source ${HOME}/code/work/beacon-security/beacon-utils/beacon_rc.sh
source ${HOME}/code/work/beacon-security/.zshrc.eks

alias pr='poetry run'
alias ap='. awsprofile'
alias av='. awsvault'

asso() {
  local profile="${1:-shared}"
  local args=(--profile "$profile")
  [[ "$(uname -s)" == "Linux" ]] && args+=(--use-device-code)
  aws sso login "${args[@]}"
}

path=(
  ${HOME}/.local/bin
  ${HOME}/code/work/ronkcon/scripts
  ${HOME}/code/work/beacon-security/core/flink/scripts/bin
  /opt/homebrew/opt/apache-flink@1/bin
  /opt/homebrew/opt/postgresql@18/bin
  $path
)

export RONKCON_CODE_ROOT="${WORK_CODE_ROOT}/ronkcon"

if [[ -d ${RONKCON_CODE_ROOT:-} ]]; then
  for file in "${RONKCON_CODE_ROOT}"/*/.go.here(N); do
    [[ -f $file ]] || continue
    BASE_DIR=$RONKCON_CODE_ROOT source "$file"
  done
fi

cdoutpost() {
   cd /Users/ronk/code/work/beacon-security/core/supervisor/outpost_manager_cli
}

if command -v bcon &> /dev/null; then
  bcon completion zsh > "${fpath[1]}/_bcon"
fi

