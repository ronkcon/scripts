#!/bin/zsh
# Must be sourced: . set_kubernetes_context <context>

if [[ "${BASH_SOURCE[0]}" == "${0}" ]] 2>/dev/null || [[ "$ZSH_EVAL_CONTEXT" == "toplevel" ]]; then
  echo "Error: must be sourced, not executed. Run: . set_kubernetes_context <context>" >&2
  return 1 2>/dev/null || exit 1
fi

if [[ -z "$1" ]]; then
  echo "Usage: . set_kubernetes_context <context>" >&2
  return 1
fi

export CONTEXT="$1"

_SKC_CLUSTER_ARN=$(kubectl config get-contexts "${CONTEXT}" --no-headers 2>/dev/null | awk '{print $3}')
if [[ -n "$_SKC_CLUSTER_ARN" ]]; then
  export AWS_REGION=$(echo "$_SKC_CLUSTER_ARN" | awk -F: '{print $4}')
  export AWS_PROFILE=$(yq ".users[] | select(.name == \"${_SKC_CLUSTER_ARN}\") | .user.exec.env[] | select(.name == \"AWS_PROFILE\") | .value" ~/.kube/config)
fi
unset _SKC_CLUSTER_ARN

alias k="kubectl --context=${CONTEXT}"
alias kgp="kubectl --context=${CONTEXT} get pods"
alias kl="kubectl --context=${CONTEXT} logs"
alias klf="kubectl --context=${CONTEXT} logs -f"
alias kdp="kubectl --context=${CONTEXT} describe pods"
alias kdelp="kubectl --context=${CONTEXT} delete pods"
alias kgcm="kubectl --context=${CONTEXT} get configmaps"
alias stern="stern --context=${CONTEXT}"
alias k9s="\k9s --context=${CONTEXT}"
alias helm="\helm --kube-context=${CONTEXT}"

echo "kubectl context set to: ${CONTEXT}"
