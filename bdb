#!/bin/bash

help() { 
    if [ -z "${SCRIPT}" ];
    then
        SCRIPT=$(basename "$0")
    fi
    printf "\n"
    printf "Connects to Beacon PSQL DBs\n"
    printf "\n"
    printf "Usage:\n"
    printf "\t%s <environment>\n" "${SCRIPT}"
    printf "\n"
    printf "Options:\n"
    printf "\n"
    printf "<environment>:\n"
    printf "\tThe name of the environment, must be one of: [localhost, dev, campari-dev, campari-prod, soju-prod].\n"
    printf "\n"
    printf "Examples:\n"
    printf "\t# Connect to Dev\n"
    printf "\t%s dev \n" "${SCRIPT}"
    printf "\n"
    exit 1
}

ENV_NAME=$1

if [ -z ${ENV_NAME} ]; then
    help
fi

case "${ENV_NAME}" in
    localhost)
        DB_SERVER=127.0.0.1
        DB_PORT=5432
        DB_NAME=mydatabase
        USERNAME=user
        PASSWORD_FILE=/Users/ronk/.config/beacon/.local.pg.pwd
        ;;
    dev)
        DB_SERVER=dev-dev.cyb2q0w4e3cd.us-east-1.rds.amazonaws.com
        DB_PORT=5432
        DB_NAME=postgres
        USERNAME=beacon
        PASSWORD_FILE=/Users/ronk/.config/beacon/.dev.rds.pwd
        ;;    
    campari-dev)
        DB_SERVER=prod-campari-dev.cl28i8uaqk9r.eu-west-1.rds.amazonaws.com
        DB_PORT=5432
        DB_NAME=postgres
        USERNAME=beacon
        PASSWORD_FILE=/Users/ronk/.config/beacon/.campari.dev.rds.pwd
        ;;            
    campari-prod)
        DB_SERVER=prod-campari-production.cl28i8uaqk9r.eu-west-1.rds.amazonaws.com
        DB_PORT=5432
        DB_NAME=postgres
        USERNAME=beacon
        PASSWORD_FILE=/Users/ronk/.config/beacon/.campari.prod.rds.pwd
        ;;            
    soju-prod)
        DB_SERVER=prod-soju-production.c32y0i8swmf9.us-west-2.rds.amazonaws.com
        DB_PORT=5432
        DB_NAME=postgres
        USERNAME=beacon
        PASSWORD_FILE=/Users/ronk/.config/beacon/.soju.prod.rds.pwd
        ;;            
    *)
        echo "Unsupported env ${ENV_NAME}!"
        exit 1
        ;;
esac

echo "Connecting to ${ENV_NAME}"

psqlenv --db-server ${DB_SERVER} --db-port ${DB_PORT} --db-name ${DB_NAME} --username ${USERNAME} --password-file ${PASSWORD_FILE}
